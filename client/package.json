{
  "name": "temphire-client",
  "version": "0.0.0",
  "description": "TempHire - React + BreezeJS client (converted from the Angular client, itself converted from the WPF/DevForce sample)",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "build:server": "tsc -b && vite build --outDir ../server/TempHire.Server/wwwroot --emptyOutDir",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "model": "npm run model:metadata && npm run model:generate",
    "model:metadata": "dotnet run --project ../server/TempHire.Server -- --export-metadata ../../client/metadata.json",
    "model:generate": "breeze-gen-entities --metadata metadata.json --out src/app/core/model --base BaseEntity --base-module ./base-entity"
  },
  "dependencies": {
    "@ideablade/validation": "file:../packages/ideablade-validation-0.1.0-preview.8.tgz",
    "@mantine/core": "^9.8.1",
    "@mantine/dates": "^9.8.1",
    "@mantine/form": "^9.8.1",
    "@mantine/hooks": "^9.8.1",
    "@mantine/modals": "^9.8.1",
    "@mantine/notifications": "^9.8.1",
    "@tabler/icons-react": "^3.52.0",
    "breeze-client": "^3.0.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.18",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
