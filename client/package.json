{
  "name": "temphire-client",
  "version": "0.0.0",
  "description": "TempHire - React + BreezeJS client (converted from the Angular client, itself converted from the WPF/DevForce sample)",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "build:server": "tsc -b && vite build --outDir ../server/TempHire.Server/wwwroot --emptyOutDir",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "model": "npm run model:metadata && npm run model:generate",
    "model:metadata": "dotnet run --project ../server/TempHire.Server -- --export-metadata ../../client/metadata.json",
    "model:generate": "breeze-gen-entities --metadata metadata.json --out src/app/core/model --base BaseEntity --base-module ./base-entity"
  },
  "dependencies": {
    "@mantine/core": "^9.8.2",
    "@mantine/dates": "^9.8.2",
    "@mantine/form": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@mantine/modals": "^9.8.2",
    "@mantine/notifications": "^9.8.2",
    "@tabler/icons-react": "^3.53.0",
    "breeze-client": "^3.0.1",
    "dayjs": "^1.11.23",
    "dompurify": "^3.5.0",
    "ideablade-validation": "^0.1.1",
    "marked": "^18.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3"
  },
  "devDependencies": {
    "@babel/core": "^8.1.4",
    "@eslint/js": "^10.0.0",
    "@rolldown/plugin-babel": "^0.3.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.16.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
